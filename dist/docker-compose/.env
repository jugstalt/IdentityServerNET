# =============================================================================
# IdentityServer.NET – Docker Compose Environment
#
# Copy or adapt this file for your deployment, then run:
#   docker compose up -d
#
# All values here have sensible defaults and can be left commented out
# if you are happy with the default. Lines starting with # are comments.
# =============================================================================


# -----------------------------------------------------------------------------
# Host port
# The container always listens on port 8080 internally.
# Change HOST_PORT to expose it on a different port on the host.
# -----------------------------------------------------------------------------
HOST_PORT=8080


# =============================================================================
# Application
# =============================================================================

# Public-facing URL of the IdentityServer (scheme + host + optional port).
# Used in OIDC discovery, redirect URIs, and email links.
# Must match the URL your users (and clients) reach the server on.
IDENTITYSERVER__PUBLICORIGIN=http://localhost:8080

# Title shown in the browser tab and on the login page.
IDENTITYSERVER__APPLICATIONTITLE=IdentityServer.NET


# =============================================================================
# Storage / Database
# Exactly one connection string should be set. All others must be absent or
# empty. If none is set, an in-memory store is used (data lost on restart).
# =============================================================================

# --- LiteDB (default, file-based, no extra service needed) ---
IDENTITYSERVER__CONNECTIONSTRINGS__LITEDB=/home/app/identityserver-net/is_identityserver-net.db
# Note: the volume is mounted at /home/app (not /home/app/identityserver-net) so
# Docker copies the correct file-system ownership from the image (app user).

# --- SQL Server ---
# IDENTITYSERVER__CONNECTIONSTRINGS__SQLSERVER=Server=db;Database=IdentityServerNET;User Id=sa;Password=YourStrong!Passw0rd;TrustServerCertificate=True

# --- PostgreSQL ---
# IDENTITYSERVER__CONNECTIONSTRINGS__POSTGRES=Host=db;Database=identityservernet;Username=postgres;Password=yourpassword

# --- SQLite ---
# IDENTITYSERVER__CONNECTIONSTRINGS__SQLITE=Data Source=/home/app/identityserver-net/is_identityserver-net.sqlite

# --- MongoDB ---
# IDENTITYSERVER__CONNECTIONSTRINGS__MONGODB=mongodb://mongo:27017


# =============================================================================
# Signing credential
# A self-signed certificate is generated automatically on first start and
# stored under {StorageRootPath}/storage/validation/ (see volume below).
# Change the password to something random and keep it secret.
# =============================================================================
IDENTITYSERVER__SIGNINGCREDENTIAL__CERTPASSWORD=Change-This-Password!


# =============================================================================
# Cookie
# =============================================================================
IDENTITYSERVER__COOKIE__NAME=identityserver-net
# IDENTITYSERVER__COOKIE__DOMAIN=
IDENTITYSERVER__COOKIE__PATH=/
IDENTITYSERVER__COOKIE__EXPIREDAYS=1


# =============================================================================
# Reverse-proxy / HTTPS termination
# When running behind nginx, Traefik, or any TLS-terminating proxy:
#   UseHttpsRedirection=false  → no redirect inside the container
#   AddXForwardedProtoMiddleware=true → trust the X-Forwarded-Proto header
# =============================================================================
IDENTITYSERVER__CONFIGURE__USEHTTPSREDIRECTION=false
IDENTITYSERVER__CONFIGURE__ADDXFORWARDEDPROTOMIDDLEWARE=true


# =============================================================================
# Login options
# =============================================================================

# Prevent users from logging in with a local username/password.
# Useful when only external identity providers (e.g. Azure AD) are configured.
# IDENTITYSERVER__LOGIN__DENYLOCALLOGIN=false

# Hide the "Forgot password?" link on the login page.
# IDENTITYSERVER__LOGIN__DENYFORGOTPASSWORDCHALLANGE=false

# Hide the "Remember me" checkbox on the login page.
# IDENTITYSERVER__LOGIN__DENYREMEMBERLOGIN=false

# Pre-check "Remember me" by default when the checkbox is visible.
# IDENTITYSERVER__LOGIN__REMEMBERLOGINDEFAULTVALUE=false

# Redirect already-authenticated users away from the login page to this URL.
# IDENTITYSERVER__REDIRECTAUTHUSERSTOCLIENTURL=

# Redirect anonymous visitors (e.g. to /connect/authorize) to this URL instead
# of showing the login page.
# IDENTITYSERVER__REDIRECTANONYMOUSUSERSTOCLIENTURL=


# =============================================================================
# Passkey (WebAuthn / FIDO2)
# Passkeys let users authenticate with biometrics or hardware security keys
# instead of (or in addition to) a password.
# =============================================================================

# Allow passwordless first-factor sign-in via passkey.
# When enabled, users can log in without entering a password at all.
# IDENTITYSERVER__LOGIN__PASSKEY__ALLOWPASSWORDLESS=false

# Allow passkey as a second factor after username/password (2FA via passkey).
# IDENTITYSERVER__LOGIN__PASSKEY__ALLOWSECONDFACTOR=false

# WebAuthn Relying Party ID.
# Must be the effective domain of your deployment (e.g. "example.com").
# Required when passkeys are enabled; leave blank to inherit from the request host.
# IDENTITYSERVER__LOGIN__PASSKEY__SERVERDOMAIN=

# Human-readable name shown in the authenticator during passkey registration.
# IDENTITYSERVER__LOGIN__PASSKEY__RELYINGPARTYNAME=IdentityServer.NET


# =============================================================================
# Account self-service
# =============================================================================

# Prevent users from registering a new account on the /Account/Register page.
# IDENTITYSERVER__ACCOUNT__DENYREGISTERACCOUNT=false

# Prevent users from managing their own account (change password, 2FA, etc.).
# IDENTITYSERVER__ACCOUNT__DENYMANAGEACCOUNT=false


# =============================================================================
# Admin UI – section visibility
# Set any of these to "true" to hide the corresponding admin section entirely.
# =============================================================================
# IDENTITYSERVER__ADMIN__DENYADMINUSERS=false
# IDENTITYSERVER__ADMIN__DENYADMINROLES=false
# IDENTITYSERVER__ADMIN__DENYADMINRESOURCES=false
# IDENTITYSERVER__ADMIN__DENYADMINCLIENTS=false
# IDENTITYSERVER__ADMIN__DENYADMINSECRETSVAULT=false
# IDENTITYSERVER__ADMIN__DENYSIGNINGUI=false
# IDENTITYSERVER__ADMIN__DENYADMINCREATECERTS=false
# IDENTITYSERVER__ADMIN__ALLOWDATATRANSFER=false


# =============================================================================
# External identity providers
# =============================================================================

# --- Microsoft / Azure AD ---
# IDENTITYSERVER__EXTERNAL__MICROSOFTIDENTITYWEB__CLIENTID=
# IDENTITYSERVER__EXTERNAL__MICROSOFTIDENTITYWEB__CLIENTSECRET=
# IDENTITYSERVER__EXTERNAL__MICROSOFTIDENTITYWEB__TENANTID=
# IDENTITYSERVER__EXTERNAL__MICROSOFTIDENTITYWEB__DOMAIN=
# IDENTITYSERVER__EXTERNAL__MICROSOFTIDENTITYWEB__NAME=Microsoft


# =============================================================================
# Mail / E-mail sender
# Required for email confirmation, password reset, etc.
# Configure exactly one sender. All others must remain commented out.
# =============================================================================

# --- SMTP ---
# IDENTITYSERVER__MAIL__SMTP__HOST=smtp.example.com
# IDENTITYSERVER__MAIL__SMTP__PORT=587
# IDENTITYSERVER__MAIL__SMTP__USERNAME=user@example.com
# IDENTITYSERVER__MAIL__SMTP__PASSWORD=smtp-password
# IDENTITYSERVER__MAIL__SMTP__FROM=noreply@example.com
# IDENTITYSERVER__MAIL__SMTP__ENABLESSL=true

# --- SendGrid ---
# IDENTITYSERVER__MAIL__SENDGRID__APIKEY=SG.xxxxxxxxxxxx
# IDENTITYSERVER__MAIL__SENDGRID__FROM=noreply@example.com

# --- MailJet ---
# IDENTITYSERVER__MAIL__MAILJET__APIKEY=
# IDENTITYSERVER__MAIL__MAILJET__SECRETKEY=
# IDENTITYSERVER__MAIL__MAILJET__FROM=noreply@example.com

# Path inside the container where custom mail templates (*.html) are stored.
# Mount your templates folder to this path via an additional volume entry.
# IDENTITYSERVER__MAIL__TEMPLATESPATH=/home/app/identityserver-net/mails


# =============================================================================
# Seeding (Migrations)
# Migrations run only when ASPNETCORE_ENVIRONMENT=Development.
# They are applied once on first start when the database is empty.
# Remove or comment out ASPNETCORE_ENVIRONMENT after the first start, or leave
# it in place — subsequent runs skip already-existing entries.
# The admin user is created with the e-mail address used to log into the
# admin area. Change the password before exposing the server publicly.
# =============================================================================
ASPNETCORE_ENVIRONMENT=Development
IDENTITYSERVER__MIGRATIONS__ADMINPASSWORD=admin

# --- Identity Resources (standard OIDC scopes) ---
# IDENTITYSERVER__MIGRATIONS__IDENTITYRESOURCES__0__NAME=openid
# IDENTITYSERVER__MIGRATIONS__IDENTITYRESOURCES__1__NAME=profile
# IDENTITYSERVER__MIGRATIONS__IDENTITYRESOURCES__2__NAME=role

# --- API Resources ---
# IDENTITYSERVER__MIGRATIONS__APIRESOURCES__0__NAME=my-api
# IDENTITYSERVER__MIGRATIONS__APIRESOURCES__0__APISECRET=apisecret
# IDENTITYSERVER__MIGRATIONS__APIRESOURCES__0__SCOPES__0__NAME=read
# IDENTITYSERVER__MIGRATIONS__APIRESOURCES__0__SCOPES__1__NAME=write

# --- Roles ---
# IDENTITYSERVER__MIGRATIONS__ROLES__0__NAME=admin
# IDENTITYSERVER__MIGRATIONS__ROLES__1__NAME=user

# --- Additional Users ---
# IDENTITYSERVER__MIGRATIONS__USERS__0__NAME=alice@example.com
# IDENTITYSERVER__MIGRATIONS__USERS__0__PASSWORD=Alice1234!
# IDENTITYSERVER__MIGRATIONS__USERS__0__ROLES__0=admin
# IDENTITYSERVER__MIGRATIONS__USERS__0__ROLES__1=user

# --- Clients ---
# ClientType: WebApplication | ApiClient | JavascriptClient

# Web Application (Authorization Code + PKCE)
# IDENTITYSERVER__MIGRATIONS__CLIENTS__0__CLIENTTYPE=WebApplication
# IDENTITYSERVER__MIGRATIONS__CLIENTS__0__CLIENTID=my-webapp
# IDENTITYSERVER__MIGRATIONS__CLIENTS__0__CLIENTSECRET=secret
# IDENTITYSERVER__MIGRATIONS__CLIENTS__0__CLIENTURL=https://myapp.example.com
# IDENTITYSERVER__MIGRATIONS__CLIENTS__0__SCOPES__0=openid
# IDENTITYSERVER__MIGRATIONS__CLIENTS__0__SCOPES__1=profile
# IDENTITYSERVER__MIGRATIONS__CLIENTS__0__SCOPES__2=role
# IDENTITYSERVER__MIGRATIONS__CLIENTS__0__ADDITIONALREDIRECTURIS__0=https://myapp.example.com/signin-oidc-alt
# IDENTITYSERVER__MIGRATIONS__CLIENTS__0__ADDITIONALGRANTTYPES__0=urn:ietf:params:oauth:grant-type:device_code

# Machine-to-machine / API Client (Client Credentials)
# IDENTITYSERVER__MIGRATIONS__CLIENTS__1__CLIENTTYPE=ApiClient
# IDENTITYSERVER__MIGRATIONS__CLIENTS__1__CLIENTID=my-service
# IDENTITYSERVER__MIGRATIONS__CLIENTS__1__CLIENTSECRET=secret
# IDENTITYSERVER__MIGRATIONS__CLIENTS__1__SCOPES__0=my-api
# IDENTITYSERVER__MIGRATIONS__CLIENTS__1__SCOPES__1=my-api.read

# JavaScript / SPA Client (Authorization Code + PKCE, no secret)
# IDENTITYSERVER__MIGRATIONS__CLIENTS__2__CLIENTTYPE=JavascriptClient
# IDENTITYSERVER__MIGRATIONS__CLIENTS__2__CLIENTID=my-spa
# IDENTITYSERVER__MIGRATIONS__CLIENTS__2__CLIENTURL=https://spa.example.com
# IDENTITYSERVER__MIGRATIONS__CLIENTS__2__SCOPES__0=openid
# IDENTITYSERVER__MIGRATIONS__CLIENTS__2__SCOPES__1=profile
