<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – IS Test Client</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body { background-color: #f0f2f5; }
        .flow-card { border: none; box-shadow: 0 2px 6px rgba(0,0,0,.08); transition: transform .15s, box-shadow .15s; }
        .flow-card:hover { transform: translateY(-3px); box-shadow: 0 6px 16px rgba(0,0,0,.14); }
        .flow-icon { font-size: 2rem; }
        .token-mono { font-family: monospace; font-size: 0.75rem; word-break: break-all; color: #555; }
        pre.json-dark { background: #1e1e1e; color: #d4d4d4; padding: 1rem; border-radius: .5rem; font-size: 0.78rem; overflow-x: auto; margin: 0; }
        .badge-grant { font-size: 0.65rem; vertical-align: middle; }
        .form-section { background: #fff; border-radius: .5rem; box-shadow: 0 2px 6px rgba(0,0,0,.06); padding: 1.5rem; }
    </style>
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm mb-4">
    <div class="container-fluid">
        <a class="navbar-brand fw-semibold" href="/"><i class="bi bi-shield-lock-fill text-warning"></i> IS Test Client</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navMain">
            <ul class="navbar-nav me-auto">
                <li class="nav-item"><a class="nav-link" href="/"><i class="bi bi-house"></i> Home</a></li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                        <i class="bi bi-person-check"></i> Interactive
                    </a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="/Oidc/Login"><i class="bi bi-box-arrow-in-right me-2"></i>Login (OIDC)</a></li>
                        <li><a class="dropdown-item" href="/ManualCode"><i class="bi bi-code-slash me-2"></i>Manual Code + PKCE</a></li>
                        <li><a class="dropdown-item" href="/DeviceFlow"><i class="bi bi-tv me-2"></i>Device Flow</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li><a class="dropdown-item text-danger" href="/Oidc/Logout"><i class="bi bi-box-arrow-right me-2"></i>Logout</a></li>
                    </ul>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                        <i class="bi bi-gear"></i> M2M
                    </a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="/ClientCredentials"><i class="bi bi-key me-2"></i>Client Credentials</a></li>
                        <li><a class="dropdown-item" href="/Ropc"><i class="bi bi-person-key me-2"></i>Resource Owner Password</a></li>
                        <li><a class="dropdown-item" href="/RefreshToken"><i class="bi bi-arrow-clockwise me-2"></i>Refresh Token</a></li>
                    </ul>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                        <i class="bi bi-search"></i> Inspect
                    </a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="/UserInfo"><i class="bi bi-person-lines-fill me-2"></i>UserInfo</a></li>
                        <li><a class="dropdown-item" href="/TokenInspector"><i class="bi bi-braces me-2"></i>Token Inspector</a></li>
                        <li><a class="dropdown-item" href="/Discovery"><i class="bi bi-binoculars me-2"></i>Discovery Document</a></li>
                    </ul>
                </li>
            </ul>
            <div class="d-flex align-items-center gap-2">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="text-success small"><i class="bi bi-person-check-fill"></i> @User.Identity.Name</span>
                    <a class="btn btn-outline-danger btn-sm" href="/Oidc/Logout">Logout</a>
                }
                else
                {
                    <a class="btn btn-outline-success btn-sm" href="/Oidc/Login"><i class="bi bi-box-arrow-in-right me-1"></i>Login</a>
                }
            </div>
        </div>
    </div>
</nav>
<div class="container pb-5">
    @RenderBody()
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
