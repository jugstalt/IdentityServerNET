@model RefreshTokenModel
@{
    ViewData["Title"] = "Refresh Token";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
        <li class="breadcrumb-item active">Refresh Token</li>
    </ol>
</nav>

<div class="row mb-3">
    <div class="col">
        <h2 class="h4 fw-bold mb-1"><i class="bi bi-arrow-clockwise text-secondary me-2"></i>Refresh Token</h2>
        <p class="text-muted mb-0">
            Exchange a refresh token for a new access token.
            <span class="badge bg-secondary ms-1">refresh_token grant</span>
        </p>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.RefreshToken))
{
    <div class="alert alert-info py-2 small mb-3">
        <i class="bi bi-info-circle me-1"></i>
        Refresh token pre-filled from your current session (Interactive Login).
    </div>
}

<div class="row g-4">
    <div class="col-lg-5">
        <div class="form-section">
            <form method="post" data-testid="form-refresh">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Authority</label>
                    <input name="Authority" value="@Model.Authority" class="form-control font-monospace"
                           data-testid="input-authority" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Client ID</label>
                    <input name="ClientId" value="@Model.ClientId" class="form-control font-monospace"
                           data-testid="input-client-id" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Client Secret</label>
                    <input name="ClientSecret" value="@Model.ClientSecret" class="form-control font-monospace"
                           data-testid="input-client-secret" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Refresh Token</label>
                    <textarea name="RefreshToken" class="form-control font-monospace" rows="4"
                              data-testid="input-refresh-token" required>@Model.RefreshToken</textarea>
                </div>
                <button type="submit" class="btn btn-secondary w-100" data-testid="btn-submit">
                    <i class="bi bi-arrow-clockwise me-1"></i>Refresh
                </button>
            </form>
        </div>
    </div>
    <div class="col-lg-7">
        @if (Model.Result is not null)
        {
            @await Html.PartialAsync("_FlowResult", Model.Result)
        }
        else
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-arrow-left display-4"></i>
                <p class="mt-2">Fill in the form and click <em>Refresh</em></p>
            </div>
        }
    </div>
</div>
