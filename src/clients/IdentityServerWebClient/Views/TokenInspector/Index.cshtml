@model TokenInspectorModel
@{
    ViewData["Title"] = "Token Inspector";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
        <li class="breadcrumb-item active">Token Inspector</li>
    </ol>
</nav>

<div class="row mb-3">
    <div class="col">
        <h2 class="h4 fw-bold mb-1" style="color:#6f42c1"><i class="bi bi-braces me-2"></i>Token Inspector</h2>
        <p class="text-muted mb-0">Decode a JWT locally or validate it via the introspection endpoint.</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Token))
{
    <div class="alert alert-info py-2 small mb-3">
        <i class="bi bi-info-circle me-1"></i>
        Access token pre-filled from your current session (Interactive Login).
    </div>
}

<div class="form-section mb-4">
    <form method="post" data-testid="form-token-inspector">
        <div class="mb-3">
            <label class="form-label fw-semibold">JWT Token</label>
            <textarea name="Token" class="form-control font-monospace" rows="4"
                      data-testid="input-token">@Model.Token</textarea>
        </div>
        <div class="row g-3 align-items-end mb-3">
            <div class="col-md-5">
                <label class="form-label fw-semibold">Authority <span class="text-muted fw-normal">(for introspection)</span></label>
                <input name="Authority" value="@Model.Authority" class="form-control font-monospace"
                       data-testid="input-authority" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold">Client ID</label>
                <input name="IntrospectionClientId" value="@Model.IntrospectionClientId" class="form-control font-monospace"
                       data-testid="input-introspect-client-id" />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold">Client Secret</label>
                <input name="IntrospectionClientSecret" value="@Model.IntrospectionClientSecret" class="form-control font-monospace"
                       data-testid="input-introspect-client-secret" />
            </div>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" name="action" value="decode" class="btn btn-outline-primary" data-testid="btn-decode">
                <i class="bi bi-braces me-1"></i>Decode JWT
            </button>
            <button type="submit" name="action" value="introspect" class="btn" style="background:#6f42c1;color:#fff" data-testid="btn-introspect">
                <i class="bi bi-shield-check me-1"></i>Introspect (server-side)
            </button>
        </div>
    </form>
</div>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger" data-testid="inspector-error">
        <i class="bi bi-x-circle me-1"></i>@Model.Error
    </div>
}

@if (!string.IsNullOrEmpty(Model.Payload))
{
    <div class="row g-3">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header fw-semibold py-2"><i class="bi bi-file-earmark-code me-1"></i>Header</div>
                <div class="card-body p-3">
                    <pre class="json-dark mb-0" data-testid="decoded-header">@Model.Header</pre>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header fw-semibold py-2"><i class="bi bi-braces me-1"></i>Payload</div>
                <div class="card-body p-3">
                    <pre class="json-dark mb-0" data-testid="decoded-payload">@Model.Payload</pre>
                </div>
            </div>
        </div>
    </div>
}

@if (Model.IsActive is not null)
{
    <div class="card mt-3">
        <div class="card-header fw-semibold py-2">
            <i class="bi bi-shield-check me-1"></i>Introspection Result
            @if (Model.IsActive == true)
            {
                <span class="badge bg-success ms-2">Active</span>
            }
            else
            {
                <span class="badge bg-danger ms-2">Inactive / Expired</span>
            }
        </div>
        @if (!string.IsNullOrEmpty(Model.IntrospectionResult))
        {
            <div class="card-body p-3">
                <pre class="json-dark mb-0" data-testid="introspection-result">@Model.IntrospectionResult</pre>
            </div>
        }
    </div>
}
