{
  "version": "1.0",
  "defaultProvider": "cdnjs",
  "libraries": [
    {
      "library": "jquery@3.7.1",
      "destination": "wwwroot/lib/jquery/"
    },
    {
      "provider": "jsdelivr",
      "library": "bootstrap@5.3.3",
      "destination": "wwwroot/lib/bootstrap/"
    },
    {
      "library": "qrcodejs@1.0.0",
      "destination": "wwwroot/lib/qrcodejs/"
    },
    {
      "provider": "jsdelivr",
      "library": "jquery-validation@1.21.0",
      "destination": "wwwroot/lib/jquery-validation/dist/",
      "files": [ "dist/jquery.validate.js", "dist/jquery.validate.min.js" ]
    },
    {
      "provider": "jsdelivr",
      "library": "jquery-validation-unobtrusive@4.0.0",
      "destination": "wwwroot/lib/jquery-validation-unobtrusive/",
      "files": [ "dist/jquery.validate.unobtrusive.js", "dist/jquery.validate.unobtrusive.min.js" ]
    }
  ]
}