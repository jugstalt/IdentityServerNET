@using IdentityServerNET.Abstractions.UI
@using IdentityServerNET.Extensions
@using IdentityServerNET.Extensions.DependencyInjection;
@using IdentityServerNET.Models.Extensions
@using IdentityServerNET.Services.UI;

@inject IUserInterfaceService userInterface;
@inject Microsoft.Extensions.Configuration.IConfiguration configuration;

@model LoginViewModel
@{
    Layout = "~/Views/Shared/_Layout_Login.cshtml";
    var changeUrl = Url.Action("Login", "Account", new { returnUrl = Model.ReturnUrl });

    // UIRealmMiddleware pre-populates both items before any view renders.
    bool hasClientContext = !string.IsNullOrEmpty(Model.ClientId);
    var realmTitle = Context.Items["UIRealmTitle"] as string;
    var cardTitle = !string.IsNullOrEmpty(Model.ClientName)
        ? Model.ClientName
        : (realmTitle ?? userInterface.ApplicationTitle);
}
<div class="login-page">
    <partial name="_ValidationSummary" />

    <div class="row">
        @if (Model.EnableLocalLogin || Model.VisibleExternalProviders.Any())
        {
            <div class="col-sm-6">
                <div class="card login-card">
                    <div class="card-header">
                        <table>
                            <tr>
                                <td>
                                    @* panel-logo always visible; JS probes the client logo URL silently *@
                                    <div class="panel-logo login-client-logo" id="login-panel-logo"
                                         @if (hasClientContext) { <text>data-client-logo="/ui/client-logo/@Model.ClientId"</text> }></div>
                                </td>
                                <td>
                                    <h3 class="card-title h5">@cardTitle</h3>
                                    <div>Enter your password</div>
                                </td>
                            </tr>
                        </table>
                    </div>
                    <div class="card-body">

                        @if (Model.EnableLocalLogin)
                        {
                            <form method="post" asp-action="LoginPassword" asp-controller="Account">
                                @Html.AntiForgeryToken()
                                <input type="hidden" asp-for="ReturnUrl" />
                                <input type="hidden" asp-for="Username" />

                                <fieldset>
                                    <div class="form-group">
                                        <div class="login-identifier-display">
                                            <span class="login-identifier-label">@Model.Username</span>
                                            <a href="@changeUrl" class="login-change-link">Change</a>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label asp-for="Password"></label>
                                        <input type="password" class="form-control" placeholder="Enter password..." asp-for="Password" autofocus autocomplete="current-password">
                                    </div>
                                    @if (Model.CaptchaImage != null)
                                    {
                                        <img src="data:image/png;base64,@Html.Raw(Convert.ToBase64String(Model.CaptchaImage))" />
                                        <div class="form-group">
                                            <label asp-for="CaptchaCode"></label>
                                            <input asp-for="CaptchaCode" class="form-control captcha-input"
                                                   placeholder="Enter the code from above..."
                                                   autocomplete="off"
                                                   style="text-transform: uppercase;" />
                                        </div>
                                    }
                                    @if (Model.AllowRememberLogin)
                                    {
                                        <div class="form-group login-remember">
                                            <label asp-for="RememberLogin">
                                                <input asp-for="RememberLogin">
                                                <strong>Remember My Login</strong>
                                            </label>
                                        </div>
                                    }
                                    <div class="form-group">
                                        <button class="btn btn-primary w-100" name="button" value="login">Sign in</button>
                                    </div>
                                </fieldset>
                            </form>

                            @if (configuration.DenyForgotPasswordChallange() == false && userInterface.DenyForgotPasswordChallange == false)
                            {
                                <p>
                                    <a href="~/Identity/Account/ForgotPassword?returnUrl=@Uri.EscapeDataString(Model.ReturnUrl ?? "")">Forgot Password?</a>
                                </p>
                            }
                        }

                        @if (Model.VisibleExternalProviders.Any())
                        {
                            <div class="mt-3">Login with identity provider:</div>
                            <br />
                            <ul class="list-inline">
                                @foreach (var provider in Model.VisibleExternalProviders)
                                {
                                    <li class="login-external-provider">
                                        <a class="btn btn-primary"
                                           asp-controller="External"
                                           asp-action="Challenge"
                                           asp-route-scheme="@provider.AuthenticationScheme"
                                           asp-route-returnUrl="@Model.ReturnUrl">
                                            @provider.DisplayName
                                        </a>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-warning">
                <strong>Invalid login request</strong>
                There are no login schemes configured for this client.
            </div>
        }
    </div>
</div>

<style>
    .login-client-logo {
        height: 48px;
        border-radius: 6px;
        margin-right: 8px;
    }
    div.login-client-logo.panel-logo {
        width: 48px;
        background-size: contain;
        background-repeat: no-repeat;
        background-position: center;
    }
    .login-identifier-display {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 8px 12px;
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 4px;
        margin-bottom: 4px;
    }
    .login-identifier-label {
        flex: 1;
        font-weight: 500;
        color: #495057;
        word-break: break-all;
    }
    .login-change-link {
        font-size: .85em;
        white-space: nowrap;
        color: #0d6efd;
        text-decoration: none;
    }
    .login-change-link:hover { text-decoration: underline; }
</style>

@section scripts {
<script>
    // Silently probe the client logo URL; if it loads, use it as panel-logo background.
    // Never shows a broken image — the panel-logo div always starts with realm/global CSS logo.
    (function () {
        var el = document.getElementById('login-panel-logo');
        var url = el && el.getAttribute('data-client-logo');
        if (!url) return;
        var probe = new Image();
        probe.onload = function () { el.style.backgroundImage = "url('" + url + "')"; };
        probe.src = url;
    })();
</script>
}
