@using IdentityServerNET.Abstractions.UI
@using IdentityServerNET.Extensions
@using IdentityServerNET.Extensions.DependencyInjection;
@using Microsoft.Extensions.Options;
@using IdentityServerNET.Services.UI;

@inject IUserInterfaceService userInterface;
@inject Microsoft.Extensions.Configuration.IConfiguration configuration;

@model LoginIdentifierViewModel
@{
    Layout = "~/Views/Shared/_Layout_Login.cshtml";
}
<div class="login-page">
    <partial name="_ValidationSummary" />

    <div class="row">
        @if (Model.EnableLocalLogin || Model.VisibleExternalProviders.Any())
        {
            <div class="col-sm-6">
                <div class="card login-card">
                    <div class="card-header">
                        <table>
                            <tr>
                                <td>
                                    <div class="panel-logo"></div>
                                </td>
                                <td>
                                    <h3 class="card-title h5">@userInterface.ApplicationTitle</h3>
                                    <div>Sign in</div>
                                </td>
                            </tr>
                        </table>
                    </div>
                    <div class="card-body">

                        @if (Model.EnableLocalLogin)
                        {
                            <form method="post" asp-action="Login" asp-controller="Account">
                                @Html.AntiForgeryToken()
                                <input type="hidden" asp-for="ReturnUrl" />

                                <fieldset>
                                    <div class="form-group">
                                        <label asp-for="Username"></label>
                                        <input class="form-control" placeholder="Enter username or email..." asp-for="Username" autofocus autocomplete="username">
                                    </div>
                                    <div class="form-group">
                                        <button class="btn btn-primary w-100" name="button" value="identify">Continue</button>
                                    </div>
                                </fieldset>
                            </form>

                            @if (Model.AllowPasskeyLogin)
                            {
                                <hr />
                                <div>
                                    <form id="passkey-signin-form" asp-action="PasskeySignIn" asp-controller="Account" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                                        <input type="hidden" id="passkey-assertion-json" name="assertionJson" />
                                    </form>
                                    <button id="passkey-signin-btn"
                                            class="btn btn-outline-secondary w-100"
                                            data-challenge-url="@Url.Action("PasskeyChallenge","Account")">
                                        Sign in with Passkey
                                    </button>
                                </div>
                            }

                            @if (!configuration.DenyRegisterAccount())
                            {
                                <p class="mt-3">
                                    <a href="~/Identity/Account/Register">Register a new account...</a>
                                </p>
                            }
                        }

                        @if (Model.VisibleExternalProviders.Any())
                        {
                            <div class="mt-3">Login with identity provider:</div>
                            <br />
                            <ul class="list-inline">
                                @foreach (var provider in Model.VisibleExternalProviders)
                                {
                                    <li class="login-external-provider">
                                        <a class="btn btn-primary"
                                           asp-controller="External"
                                           asp-action="Challenge"
                                           asp-route-scheme="@provider.AuthenticationScheme"
                                           asp-route-returnUrl="@Model.ReturnUrl">
                                            @provider.DisplayName
                                        </a>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-warning">
                <strong>Invalid login request</strong>
                There are no login schemes configured for this client.
            </div>
        }
    </div>
</div>

@if (Model.AllowPasskeyLogin)
{
    @section scripts {
        <script src="~/js/passkey.js"></script>
    }
}
