@using IdentityServerNET.Extensions
@using Microsoft.AspNetCore.Identity
@using IdentityServerNET.Models
@using IdentityServerNET

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject IdentityServerNET.Services.ColorSchemeService ColorScheme

@{
    var applicationUser = await UserManager.GetUserAsync(User);
    var isDark = ColorScheme.CurrentColorScheme == ColorSchemes.Dark;
    var toggleUrl = Url.Action("ToggleColorScheme", "Home");
}

@if (SignInManager.IsSignedIn(User))
{
    <ul class="navbar-nav ms-auto align-items-center">
        <li class="nav-item">
            <a class="nav-link" href="~/Home/Index" title="Home">
                <div class="@ColorScheme.NavIcon("home")"></div>
                Home
            </a>
        </li>
        @if (applicationUser.HasAdministratorRole())
        {
            <li class="nav-item">
                <a class="nav-link" href="~/admin" title="Admin">
                    <div class="@ColorScheme.NavIcon("admin")"></div>
                    Admin
                </a>
            </li>
        }
        <li class="nav-item">
            @if (Configuration.DenyManageAccount())
            {
                <a class="nav-link" href="~/Home/Index" title="Manage">
                    <div class="@ColorScheme.NavIcon("account")"></div>
                    Hello @UserManager.GetUserName(User)!
                </a>
            }
            else
            {
                <a class="nav-link" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">
                    <div class="@ColorScheme.NavIcon("account")"></div>
                    Account: @UserManager.GetUserName(User)
                </a>
            }
        </li>
        <li class="nav-item">
            <a class="nav-link" href="~/Account/Logout" title="Logout">
                <div class="@ColorScheme.NavIcon("account-logout")"></div>
                Logout
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link navbar-colorscheme-toggle" href="#"
               data-toggle-url="@toggleUrl"
               title="@(isDark ? "Switch to light mode" : "Switch to dark mode")">
                <div class="@ColorScheme.NavIcon("darkmode")"></div>
            </a>
        </li>
    </ul>
}
else
{
    <ul class="navbar-nav ms-auto align-items-center">
        <li class="nav-item">
            <a class="nav-link navbar-colorscheme-toggle" href="#"
               data-toggle-url="@toggleUrl"
               title="@(isDark ? "Switch to light mode" : "Switch to dark mode")">
                <div class="@ColorScheme.NavIcon("darkmode")"></div>
            </a>
        </li>
        @if (!Configuration.DenyRegisterAccount())
        {
            <li class="nav-item">
                <a class="nav-link" asp-area="Identity" asp-page="/Account/Register">Register</a>
            </li>
        }
        <li class="nav-item">
            <a class="nav-link" href="~/Account/Login" title="Login">Login</a>
        </li>
    </ul>
}
