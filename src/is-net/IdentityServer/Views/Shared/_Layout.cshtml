@using IdentityServerNET.Abstractions.UI
@using IdentityServer4.Extensions
@using Microsoft.Extensions.Configuration

@inject IConfiguration Configuration
@inject IUserInterfaceService userInterface;
@inject IdentityServerNET.Services.ColorSchemeService ColorScheme
@{
    #nullable enable

    string? name = null;
    if (!true.Equals(ViewData["signed-out"]))
    {
        name = Context.User?.GetDisplayName() ?? "";
    }
    static string ShortVersion(System.Version? v) => v is null ? "" : $"{v.Major}.{v.Minor}.{v.Build}";
    var footerVersionIs4 = ShortVersion(typeof(IdentityServer4.Hosting.IdentityServerMiddleware).Assembly.GetName().Version);
    var footerVersionIsNet = ShortVersion(typeof(IdentityServerNET.Models.ApplicationUser).Assembly.GetName().Version);
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(Context.Items["UIRealmTitle"] as string ?? Configuration["ApplicationTitle"])</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link href="~/css/is-net.css?v=2" rel="stylesheet" />
    <link href="~/css/is-net-dark.css?v=2" rel="stylesheet" />
    <link href="/ui/overrides.css" rel="stylesheet" />
    @if (Context.Items["UIRealm"] is string _uiRealm)
    {
        <link href="/ui/overrides.css?realm=@_uiRealm" rel="stylesheet" />
    }
    <link href="~/css/basic/content/css/sketchpen-basic-bg-light.css" rel="stylesheet" />
    <link href="~/css/basic/content/css/sketchpen-basic-bg-dark.css" rel="stylesheet" />
</head>
<body class="colorscheme-@ColorScheme.CurrentColorScheme.ToString().ToLowerInvariant()">
    <nav class="navbar navbar-expand-md" id="main-navbar">
        <div class="container">
            <a class="navbar-brand" href="~/">
                <img class="icon-banner">
                @(Context.Items["UIRealmTitle"] as string ?? userInterface.ApplicationTitle)
            </a>
            @{
                var _isDark = ColorScheme.CurrentColorScheme == IdentityServerNET.ColorSchemes.Dark;
                var _schemeIcon = _isDark ? "bulb-shining" : "darkmode";
                var _schemeTitle = _isDark ? "Switch to light mode" : "Switch to dark mode";
                var _toggleUrl = Url.Action("ToggleColorScheme", "Home");
            }
            <a class="nav-link navbar-colorscheme-toggle navbar-toggle-persistent"
               href="#"
               data-toggle-url="@_toggleUrl"
               title="@_schemeTitle">
                <div class="@ColorScheme.NavIcon(_schemeIcon)"></div>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbar"
                    aria-controls="navbar" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbar">
                <partial name="_LoginPartial" />
            </div>
        </div>
    </nav>

    <div class="container body-content">
        @RenderBody()
    </div>

    <footer class="is-net-footer">
        <div class="container">
            <div class="is-net-footer-inner">
                <span class="is-net-footer-brand">
                    <img src="~/icon.png" width="16" height="16" />
                    IdentityServer NET <span class="is-net-footer-version">@($"v{footerVersionIsNet}")</span>
                    &nbsp;·&nbsp;
                    IdentityServer4 <span class="is-net-footer-version">@($"v{footerVersionIs4}")</span>
                </span>
                <span class="is-net-footer-links">
                    <a href="~/.well-known/openid-configuration">Discovery Document</a>
                    <a href="~/home/about">About</a>
                </span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/is-net-ui.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
