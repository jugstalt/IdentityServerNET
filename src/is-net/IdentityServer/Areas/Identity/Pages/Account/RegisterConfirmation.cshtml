@page
@using IdentityServerNET.Abstractions.UI
@inject IUserInterfaceService userInterface
@model RegisterConfirmationModel
@{
    Layout = "~/Views/Shared/_Layout_Login.cshtml";
    ViewData["Title"] = "Register confirmation";
}

<div class="login-page">
    <div class="card login-card">
        <div class="card-header">
            <table><tr>
                <td><div class="panel-logo"></div></td>
                <td>
                    <h3 class="card-title h5">@userInterface.ApplicationTitle</h3>
                    <div>@ViewData["Title"]</div>
                </td>
            </tr></table>
        </div>
        <div class="card-body">
            @if (Model.DisplayConfirmAccountLink)
            {
                <p>
                    This app does not currently have a real email sender registered.
                    <a id="confirm-link" href="@Model.EmailConfirmationUrl">Click here to confirm your account</a>.
                </p>
            }
            else
            {
                <p>Please check your email to confirm your account.</p>
            }
            <div class="mt-3 text-center" style="font-size:0.875rem">
                <a href="~/Account/Login">← Back to Login</a>
            </div>
        </div>
    </div>
</div>
