@page
@using IdentityServerNET.Abstractions.UI
@using IdentityServerNET.Extensions.DependencyInjection;
@using IdentityServerNET.Services.UI;
@inject IUserInterfaceService userInterface;

@model ChangePasswordRequiredModel
@{
    Layout = "~/Views/Shared/_Layout_Login.cshtml";
    ViewData["Title"] = "Change your password";
}

<div class="login-page">
    <div class="card login-card">
        <div class="card-header">
            <table>
                <tr>
                    <td>
                        <div class="panel-logo"></div>
                    </td>
                    <td>
                        <h3 class="card-title h5">@(HttpContext.Items["UIRealmTitle"] as string ?? userInterface.ApplicationTitle)</h3>
                        <div>@ViewData["Title"]</div>
                    </td>
                </tr>
            </table>
        </div>
        <div class="card-body">
            <p>
                You are signing in with a one-time password. For security reasons, you must set a new
                password before continuing.
            </p>
            <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
                <div asp-validation-summary="All" class="text-danger"></div>
                <div class="form-group">
                    <label asp-for="Input.OldPassword"></label>
                    <input asp-for="Input.OldPassword" class="form-control" autocomplete="current-password" autofocus="on" />
                    <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Input.NewPassword"></label>
                    <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Input.ConfirmPassword"></label>
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <button type="submit" class="btn btn-primary">Change password</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section scripts {
    <partial name="_ValidationScriptsPartial" />
}
