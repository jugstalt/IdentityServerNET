@page
@using IdentityServerNET.Abstractions.UI
@using IdentityServerNET.Extensions.DependencyInjection;
@using IdentityServerNET.Services.UI;
@inject IUserInterfaceService userInterface;

@model LoginWith2faModel
@{
    Layout = "~/Views/Shared/_Layout_Login.cshtml";
    ViewData["Title"] = "Two-factor authentication";
}


<div class="login-page">
    <div class="card login-card">
            <div class="card-header">
                <table>
                    <tr>
                        <td>
                            <div class="panel-logo"></div>
                        </td>
                        <td>
                            <h3 class="card-title h5">@userInterface.ApplicationTitle</h3>
                            <div>@ViewData["Title"]</div>
                        </td>
                    </tr>
                </table>
            </div>
            <div class="card-body">
                <p>Your login is protected with an authenticator app. Enter your authenticator code below.</p>
                <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
                    <input asp-for="RememberMe" type="hidden" />
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <div class="form-group">
                        <label asp-for="Input.TwoFactorCode"></label>
                        <input asp-for="Input.TwoFactorCode" class="form-control" autocomplete="off" autofocus="on" />
                        <span asp-validation-for="Input.TwoFactorCode" class="text-danger"></span>
                    </div>
                    <div class="form-group login-remember">
                        <label asp-for="Input.RememberMachine">
                            <input asp-for="Input.RememberMachine" />
                            @Html.DisplayNameFor(m => m.Input.RememberMachine)
                        </label>
                    </div>
                    <div class="form-group">
                        <button type="submit" class="btn btn-primary">Log in</button>
                    </div>
                </form>
                <p>
                    Don't have access to your authenticator device? You can
                    <a asp-page="./LoginWithRecoveryCode" asp-route-returnUrl="@Model.ReturnUrl">log in with a recovery code</a>.
                </p>
                <div class="mt-3 text-center" style="font-size:0.875rem">
                    <a href="~/Account/Login">← Back to Login</a>
                </div>
            </div>
        </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}