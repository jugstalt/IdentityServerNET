@{
    Layout = "/Views/Shared/_Layout.cshtml";
}

@model IEditApiResourcePageModel

<nav aria-label="breadcrumb"><ol class="breadcrumb is-breadcrumb"><li class="breadcrumb-item"><a href="~/admin">Admin</a></li><li class="breadcrumb-item"><a href="~/admin/resources">Resources</a></li><li class="breadcrumb-item active">@Model?.CurrentApiResource?.Name</li></ol></nav>
<h2>Admin Resources</h2>
<div class="admin-resources">
    <h4>Modify API Resource: @Model?.CurrentApiResource?.Name</h4>
    <hr />

    <div class="row">
        <div class="col-md-3 sidebar">
            <div style="padding:10px">


            </div>

            <partial name="_EditApiResourceNav" />
        </div>
        <div class="col-md-9">
            @RenderBody()
        </div>
    </div>

</div>

@section Scripts {
    @RenderSection("scripts", required: false)
}


