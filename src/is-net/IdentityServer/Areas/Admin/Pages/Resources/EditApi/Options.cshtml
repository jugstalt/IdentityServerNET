@page
@model IdentityServer.Areas.Admin.Pages.Resources.EditApi.OptionsModel
@{
    ViewData["Title"] = "Api Options";
    ViewData["ActivePage"] = EditApiResourceNavPages.Options;
}

<h4>@ViewData["Title"]</h4>
<div class="row">
    <partial name="_StatusMessage" model="Model.StatusMessage" />
    <div class="col-md-6">

        <ul class="nav nav-pills flex-column">
            @foreach (var field in typeof(IdentityServerNET.Models.IdentityServerWrappers.ApiResourceModel).GetProperties())
            {
                if (field.CanWrite && field.PropertyType == typeof(bool))
                {
                    var name = field.Name;
                    var hasValue = (bool)field.GetValue(Model.CurrentApiResource);
                    var descAttr = (System.ComponentModel.DescriptionAttribute)field.GetCustomAttributes(typeof(System.ComponentModel.DescriptionAttribute), false).FirstOrDefault();
                    var description = descAttr?.Description;

                    <li style="border-bottom:1px solid #eee">
                        <a asp-page-handler="Set"
                           asp-route-id="@Model.CurrentApiResource.Name"
                           asp-route-option="@name"
                           asp-route-value="@(!hasValue)">
                            <div class="option-check @(hasValue ? "selected" : "")"></div>
                            <div>@System.Text.RegularExpressions.Regex.Replace(name, "(?<=[a-z])([A-Z])", " $1")</div>
                            @if (!string.IsNullOrEmpty(description))
                            {
                                <div>@description</div>
                            }
                        </a>
                    </li>
                }
            }
        </ul>
    </div>
</div>