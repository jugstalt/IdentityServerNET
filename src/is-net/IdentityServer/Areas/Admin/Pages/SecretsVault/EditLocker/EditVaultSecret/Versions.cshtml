@page
@model IdentityServer.Areas.Admin.Pages.SecretsVault.EditLocker.EditVaultSecret.VersionsModel
@{
    ViewData["Title"] = "Versions";
    ViewData["ActivePage"] = EditVaultSecretNavPages.Versions;
}
@inject IdentityServerNET.Services.ColorSchemeService ColorScheme

<div class="row">
    <partial name="_StatusMessage" model="Model.StatusMessage" />
    <div class="col-md-6">
        <h4>@ViewData["Title"]</h4>
        @if (Model.VaultSecretVersions != null)
        {
            <ul class="nav nav-pills flex-column action-list">
                @foreach (var secretVersion in Model.VaultSecretVersions.OrderByDescending(s => s.VersionTimeStamp))
                {
                    var dt = new DateTime(secretVersion.VersionTimeStamp, DateTimeKind.Utc).ToLocalTime();
                    var versionPath = $"{Model.LockerName}/{Model.CurrentSecret.Name}/{secretVersion.VersionTimeStamp}";
                    <li class="action-list-item" style="max-height: none; min-height: 44px;">
                        <div class="@ColorScheme.LeftIcon("code-c")"></div>
                        <span class="action-list-text">
                            <strong>@dt.ToShortDateString() @dt.ToLongTimeString()</strong>
                            <small><a href="~/api/secretsvault?v=1.0&path=@versionPath">@versionPath</a></small>
                        </span>
                        <a class="action-btn action-btn-remove"
                           asp-page-handler="Remove"
                           asp-route-id="@Model.CurrentSecret.Name"
                           asp-route-locker="@Model.LockerName"
                           asp-route-stamp="@secretVersion.VersionTimeStamp"
                           title="Remove">&#x2715;</a>
                    </li>
                }
            </ul>
        }
    </div>
    <div class="col-md-6">
        <div class="row collapsable-tool">
            <h4>New secret version</h4>
            <form id="-form" method="post">
                <div asp-validation-summary="All" class="text-danger"></div>
                <input type="hidden" asp-for="Input.LockerName" />
                <input type="hidden" asp-for="Input.SecretName" />
                <div class="form-group">
                    <textarea asp-for="Input.Secret" class="form-control" type="password" placeholder="Something you want to hide..." rows="5"></textarea>
                    <span asp-validation-for="Input.Secret" class="text-danger"></span>
                </div>
                <button id="add-secret-button" type="submit" class="btn btn-primary">Add</button>
            </form>
        </div>
        <partial name="_createRandomSecretPartial" />
    </div>
</div>
