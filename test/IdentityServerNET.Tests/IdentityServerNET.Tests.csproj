    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" PrivateAssets="All" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\libs\IdentityServerNET\IdentityServerNET.csproj" />
    <ProjectReference Include="..\..\src\libs-is4\IdentityServer4\src\IdentityServer4.csproj" />
  </ItemGroup>

</Project>
